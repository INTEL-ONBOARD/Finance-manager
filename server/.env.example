# ── Finwise backend service configuration ────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# MongoDB — self-hosted in-stack container (default). The compose file starts a
# `mongo` service using these root credentials; the API reaches it at mongo:27017.
MONGO_ROOT_USER=finwise
MONGO_ROOT_PASSWORD=replace-with-a-long-random-secret   # openssl rand -hex 24
MONGO_URI=mongodb://finwise:<MONGO_ROOT_PASSWORD>@mongo:27017/finwise?authSource=admin
DB_NAME=finwise
# To use MongoDB Atlas instead, drop the `mongo` service and set:
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Auth — generate a long random secret:  openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TTL=30d
REFRESH_TTL=30d
COOKIE_NAME=fw_token
# Set false only for plain-HTTP testing on a bare IP (cookies will not be Secure).
COOKIE_SECURE=true

# Realtime fan-out across instances. docker-compose injects this automatically.
REDIS_URL=redis://redis:6379

# Comma-separated web origins allowed to call the API with cookies.
# Desktop uses bearer tokens and is not origin-restricted.
CORS_ORIGINS=https://app.example.com

# Public address Caddy serves on:
#   a domain  -> automatic HTTPS via Let's Encrypt  (e.g. api.example.com)
#   :80       -> plain HTTP on the bare IP (first-test only; set COOKIE_SECURE=false)
SITE_ADDRESS=:80

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank in dev to capture emails to an in-memory outbox.
RESEND_API_KEY=
EMAIL_FROM=Finwise <no-reply@yourdomain.com>
# Base URL of the web app used in email links. The renderer uses hash routing,
# so this MUST end with /# — links are built as ${APP_WEB_URL}/verify?token=…
# which then resolves to …/finwise-app/#/verify?token=… (a valid hash route).
APP_WEB_URL=https://yourdomain.com/finwise-app/#
# Cron for the monthly summary (default: 08:00 on the 1st).
MONTHLY_CRON=0 8 1 * *
