{
  "name": "finance-manager",
  "version": "1.0.5",
  "description": "Personal Finance Management App",
  "author": "The FinMate Team",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "cross-env ELECTRON_RUN_AS_NODE= electron-vite build",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "npm run build:desktop:backend && electron-builder",
    "dist:mac": "npm run build:desktop:backend && electron-builder --mac",
    "dist:win": "npm run build:desktop:backend && electron-builder --win",
    "dist:mac:x64": "npm run build:desktop:backend && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run build:desktop:backend && electron-builder --mac --arm64",
    "dist:legacy-direct-mongo": "npm run build && electron-builder",
    "build:web": "vite build --config vite.config.web.mts",
    "dev:web": "vite --config vite.config.web.mts --host",
    "dev:desktop:backend": "cross-env VITE_USE_BACKEND=true VITE_API_BASE=https://84-247-139-75.sslip.io/finwise ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build:desktop:backend": "cross-env VITE_USE_BACKEND=true VITE_API_BASE=https://84-247-139-75.sslip.io/finwise ELECTRON_RUN_AS_NODE= electron-vite build"
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "mongodb": "^6.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
